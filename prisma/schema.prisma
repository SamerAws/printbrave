
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id          Int     @id @default(autoincrement())
  name        String
  description String
  price       Int
  image       String?
  video       String?

  media ProductMedia[]

  orderItems OrderItem[]

  createdAt DateTime @default(now())
}

model ProductMedia {
  id Int @id @default(autoincrement())

  productId Int
  product   Product @relation(fields: [productId], references: [id])

  url  String
  type String

  createdAt DateTime @default(now())
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  createdAt DateTime @default(now())
  sessions Session[]
  orders Order[]
}

model Order {
  id          Int      @id @default(autoincrement())
  customer    String
  phone       String
  governorate String
  area        String?
  landmark    String?

  product     String   

  notes       String?
  total       Int      @default(0)

  status String @default("قيد المراجعة")

  userId Int?
  user   User? @relation(fields: [userId], references: [id])

  items OrderItem[]

  createdAt DateTime @default(now())
}

model OrderItem {
  id Int @id @default(autoincrement())

  orderId Int
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId Int
  product Product @relation(fields: [productId], references: [id])

  productName String
  productImage String?
  price Int
  quantity Int @default(1)

  createdAt DateTime @default(now())
}

model VerificationCode {
  id        Int      @id @default(autoincrement())
  email     String
  code      String
  createdAt DateTime @default(now())
}

model Admin {
  id       Int    @id @default(autoincrement())
  username String @unique
  password String
}
model Session {
  id        Int      @id @default(autoincrement())

  token     String   @unique

  userId    Int
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime

  createdAt DateTime @default(now())
}