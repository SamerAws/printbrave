
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Product {
  id          Int     @id @default(autoincrement())
  name        String
  description String
  price       Int
  image       String?
  video       String?

  media ProductMedia[]

  createdAt DateTime @default(now())
}

model ProductMedia {
  id Int @id @default(autoincrement())

  productId Int
  product   Product @relation(fields: [productId], references: [id])

  url  String
  type String

  createdAt DateTime @default(now())
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  createdAt DateTime @default(now())

  orders Order[]
}

model Order {
  id          Int     @id @default(autoincrement())
  customer    String
  phone       String
  governorate String
  area        String?
  landmark    String?
  product     String
  notes       String?
  total       Int     @default(0)

  status String @default("طلب جديد")

  userId Int?
  user   User? @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
}

model VerificationCode {
  id        Int      @id @default(autoincrement())
  email     String
  code      String
  createdAt DateTime @default(now())
}

model Admin {
  id       Int    @id @default(autoincrement())
  username String @unique
  password String
}
